/*
	Source: https://github.com/Rinnegatamante/PCSX_AwO (assets/postfx/crt_bleeding)
	Based on: https://www.shadertoy.com/view/Ms23DR
*/

float2 curve(float2 uv)
{
	float2 p = (uv - 0.5) * 2.2;
	p.x *= 1.0 + 0.04 * p.y * p.y;
	p.y *= 1.0 + 0.0625 * p.x * p.x;
	return p * 0.46 + 0.5;
}

float4 main(
	float2 vTexcoord : TEXCOORD0,
	float2 screenPosition : WPOS,
	uniform sampler2D colorMap : TEXUNIT0,
	uniform float iTime,
	uniform float2 uOutputSize) : COLOR
{
	float2 uv = curve(vTexcoord);
	float3 center = tex2D(colorMap, uv).rgb;
	float2 texel = 1.0 / uOutputSize;
	float2 bleedOffset = float2(2.0 * texel.x, 0.0);
	float2 bleedMin = 0.5 * texel;
	float2 bleedMax = 1.0 - 0.5 * texel;
	float3 left = tex2D(colorMap, clamp(uv - bleedOffset, bleedMin, bleedMax)).rgb;
	float3 right = tex2D(colorMap, clamp(uv + bleedOffset, bleedMin, bleedMax)).rgb;
	float3 bleed = lerp(center, 0.5 * (left + right), 0.42);
	bleed += dot(center - bleed, float3(0.299, 0.587, 0.114));
	float3 col = bleed * 1.065 + 0.05;

	col = saturate(col * (0.6 + 0.4 * col));
	float vig = max(16.0 * uv.x * uv.y * (1.0 - uv.x) * (1.0 - uv.y), 0.0);
	float vignetting = sqrt(sqrt(vig));
	// Match the original 1.5 rad/pixel scanline frequency to avoid vertical aliasing.
	float linePhase = abs(frac(uv.y * uOutputSize.y * 0.2387324146 + 0.25 * iTime) - 0.5);
	float scanline = 0.38 + 0.8 * linePhase;
	// Use raster pixel coordinates: interpolated UVs lose shadow-mask phase past x=480.
	short pixelX = (short)floor(screenPosition.x);
	float mask = 1.0 - 0.65 * (float)(pixelX & 1);
	float valid = step(0.0, uv.x) * step(uv.x, 1.0) * step(0.0, uv.y) * step(uv.y, 1.0);
	col *= vignetting * scanline * mask * valid * 2.8;
	return float4(col * float3(0.95, 1.05, 0.95), 1.0);
}
